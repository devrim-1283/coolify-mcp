{
  "name": "@donedynamics/coolify-mcp",
  "version": "0.1.1",
  "description": "Fleet-level MCP server for Coolify — multiple instances and teams from one connection, full REST API coverage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "bin": {
    "coolify-mcp": "dist/cli.js",
    "coolify-mcp-server": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devrim-1283/coolify-mcp.git"
  },
  "homepage": "https://github.com/devrim-1283/coolify-mcp#readme",
  "bugs": {
    "url": "https://github.com/devrim-1283/coolify-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "coolify",
    "devops",
    "paas",
    "deployment",
    "claude",
    "ai"
  ],
  "scripts": {
    "build": "tsup",
    "codegen": "tsx scripts/generate-catalog.ts",
    "codegen:check": "npm run codegen && git diff --exit-code src/generated",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.4.2",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
