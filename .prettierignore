# Build output and dependencies.
dist/
node_modules/
coverage/

# The vendored OpenAPI spec is hashed into src/generated/meta.ts. Reformatting
# it would change that hash and break `npm run codegen:check`. Same reason it
# carries `-text` in .gitattributes.
scripts/coolify-openapi.json

# Generated by `npm run codegen`; the generator owns its own formatting and CI
# fails on any diff, so a formatter that disagreed with it would deadlock the
# two checks against each other.
src/generated/

# Installer fixtures encode byte-exact expectations, several of them about CRLF
# survival specifically. A formatter must not touch them.
test/install/adapters/__fixtures__/

# Lockfiles are npm's format, not ours.
package-lock.json
