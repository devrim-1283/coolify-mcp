{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/srv"
      ],
      "enabled": true,
      "environment": {
        "FS_ROOT": "/srv"
      }
    },
    "coolify": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "coolify-mcp@0.9.0"
      ],
      "enabled": false,
      "environment": {
        "COOLIFY_CONNECTION": "staging"
      }
    }
  }
}
