{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/srv"
      ],
      "env": {
        "FS_ROOT": "/srv"
      }
    },
    "coolify": {
      "command": "npx",
      "args": [
        "-y",
        "coolify-mcp@0.9.0"
      ],
      "env": {
        "COOLIFY_CONNECTION": "staging"
      },
      "disabled": true
    }
  }
}
